# Global Risk Intelligence Command Center (GRICC) - Environment Configuration

# Backend Core
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/gricc.db
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Intelligence & AI API Keys (Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here
NASA_API_KEY=your_nasa_api_key_here
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# External Intelligence Providers (Optional / Fallback)
GDELT_ENABLED=true
USGS_ENABLED=true
NASA_EONET_ENABLED=true
CISA_KEV_ENABLED=true
OPEN_METEO_ENABLED=true
WORLD_BANK_ENABLED=true

# Frontend Configuration (Vite Public)
VITE_API_BASE_URL=http://localhost:8000
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
